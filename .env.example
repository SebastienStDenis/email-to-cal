# --- iCloud mailbox ---------------------------------------------------------
# IMAP_PASSWORD must be an app-specific password from appleid.apple.com, not your
# Apple ID password. Changing your Apple ID password revokes all of them.
IMAP_HOST=imap.mail.me.com
IMAP_PORT=993
IMAP_USERNAME=you@icloud.com
IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx
IMAP_FOLDER=INBOX
# How long to hold an IDLE before re-issuing it. Keep well under 29 minutes.
IMAP_IDLE_SECONDS=300
# 0 means "only mail that arrives from now on". Raise it to backfill on first run.
FIRST_RUN_LOOKBACK_DAYS=0

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Send PDFs and (when the text is thin) images to the model.
ENABLE_VISION=true
# Off by default. Only used to resolve a venue's timezone when local lookup fails.
ENABLE_WEB_SEARCH=false
MAX_ATTACHMENT_MB=8
# Events below this confidence are logged and dropped, never written.
MIN_CONFIDENCE=0.75

# --- Google Calendar --------------------------------------------------------
GOOGLE_CREDENTIALS_FILE=/data/credentials.json
GOOGLE_TOKEN_FILE=/data/token.json
# Calendar for anything that does not match a category. "primary" is your main one.
DEFAULT_CALENDAR=primary
# Used when an email gives a time but no location we can resolve.
DEFAULT_TIMEZONE=Europe/Zurich

# --- Categories -------------------------------------------------------------
# A JSON array of {name, description, calendar}. The description is what the model
# matches against, so write it for the model: say what belongs and what does not.
# Calendars that do not exist yet are created on first run.
CATEGORIES=[{"name":"travel","description":"Flights, trains, ferries, and hotel stays. Anything involving getting to or staying somewhere away from home.","calendar":"Sebastiens Travels"},{"name":"music","description":"Concerts, gigs, festivals, club nights, and other live music the recipient has tickets for.","calendar":"Music"},{"name":"dining","description":"Restaurant and bar reservations.","calendar":"Dining"}]
# Alternative to the above: point at a mounted YAML file with the same shape.
# CATEGORIES_FILE=/data/categories.yaml

# --- Service ----------------------------------------------------------------
STATE_DB=/data/state.sqlite
# true logs the exact Google payloads without writing anything. Start here.
DRY_RUN=true
LOG_LEVEL=INFO
